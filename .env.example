# Used only by jll_people_scraper.js
# Copy this file to .env and fill in your own values.

# Required: open jll.com/en-us/people in Chrome, open DevTools (F12) -> Network tab,
# find the "template" request, and copy the value of its `subscription-key` header.
JLL_SUBSCRIPTION_KEY=

# Optional: only needed if the subscription key alone gets a 401/403.
# Paste your browser cookie value from the same request here.
JLL_COOKIE=
